{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "factorio-calculator-ui",
  "version": "0.1.0",
  "identifier": "com.hong19.factorio-calculator-ui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Factorio Calculator",
        "width": 1000,
        "height": 800,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../src/favicon.png"
    ]
  }
}
